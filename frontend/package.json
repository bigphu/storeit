{
  "name": "storeit-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "check": "npm run typecheck && npm run test && vite build",
    "gen:api": "openapi-typescript ../backend/internal/identity/handler/openapi.yaml -o src/lib/api/identity.d.ts && openapi-typescript ../backend/internal/inventory/handler/openapi.yaml -o src/lib/api/inventory.d.ts"
  },
  "dependencies": {
    "@primeuix/themes": "^3.0.1",
    "@tanstack/vue-query": "^5.104.1",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
