# Chỉ dùng để thay ${...} trong compose.yml — KHÔNG tự vào container.
# Không để mật khẩu ở đây: dùng deploy/postgres/secrets/*.txt
# cp .env.example .env

# Port trên máy host (127.0.0.1): web = frontend (Vite), app = API + Swagger UI
WEB_PORT=3000
APP_PORT=8080
PG_PORT=5432

# DB + user của app — do deploy/postgres/initdb/01-app.sh tạo lần đầu.
# Đổi sau khi volume pgdata đã tồn tại thì phải: make db-reset CONFIRM=yes
APP_DB_NAME=storeit
APP_DB_USER=app_user

# pgAdmin (make pgadmin)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@storeit.dev

# JWT (không phải secret; keyring nằm ở deploy/app/secrets/jwt_keys.txt)
# Rotate key: xem deploy/app/secrets/jwt_keys.txt + đổi JWT_ACTIVE_KID
JWT_ACTIVE_KID=v1
JWT_ISSUER=storeit

# Administrator đầu tiên, tạo khi DB chưa có account nào (mật khẩu 12-72 byte).
# Đăng nhập được rồi thì xoá hai dòng này.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mật khẩu chung của account demo tạo bởi `make seed` (12-72 byte)
SEED_PASSWORD=

# Frontend: link trong thư mời / đặt lại mật khẩu trỏ về đây (mặc định theo WEB_PORT).
# Mở app qua tên miền thì đặt tên miền đó, rồi docker compose up -d (tạo lại app, worker)
#APP_URL=https://storeit.example.com

# Dev server (Vite) mở qua tên miền khác localhost: liệt kê tên miền (dấu phẩy), và qua
# HTTPS (reverse proxy, tunnel) thì HMR nối về port 443
#VITE_ALLOWED_HOSTS=storeit.example.com
#VITE_HMR_CLIENT_PORT=443
# Mailpit (hộp thư dev): giao diện web và cổng SMTP trên host
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025

# Mail (worker). Dev mặc định gửi vào Mailpit: http://localhost:8025.
# Gửi thư thật qua Resend SMTP: dán API key vào deploy/app/secrets/smtp_password.txt,
# bỏ comment các dòng dưới (MAIL_FROM phải thuộc domain đã xác thực ở Resend),
# rồi docker compose up -d để tạo lại worker
#MAIL_FROM=StoreIt <no-reply@your-domain.com>
#MAIL_SMTP_HOST=smtp.resend.com
#MAIL_SMTP_PORT=465
#MAIL_SMTP_TLS=tls
#MAIL_SMTP_USERNAME=resend
#MAIL_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
