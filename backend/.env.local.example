# Env cho Go chạy trên host (make run-api, make test), Docker không dùng file này.
# cp .env.local.example .env.local
# Được Makefile include (cú pháp make): KEY=value, không dùng dấu nháy.

# Địa chỉ HTTP server nghe (server.Config)
HTTP_ADDR=:8080

PGHOST=127.0.0.1
# Phải khớp PG_PORT trong .env
PGPORT=5432
PGDATABASE=storeit
PGUSER=app_user
PGPASSWORD_FILE=../deploy/postgres/secrets/pg_app_pw.txt
PGSSLMODE=verify-full
PGSSLROOTCERT=../deploy/postgres/certs/rootCA.pem

# json (mặc định) | pretty; debug | info | warn | error
LOG_FORMAT=pretty
LOG_LEVEL=info

# JWT: keyring "kid:base64,..." trong file, JWT_ACTIVE_KID phải có trong keyring
JWT_KEYS_FILE=../deploy/app/secrets/jwt_keys.txt
JWT_ACTIVE_KID=v1
JWT_ISSUER=storeit

# Identity: dev chạy http nên tắt cờ Secure của cookie refresh
IDENTITY_COOKIE_SECURE=false
# Administrator đầu tiên, tạo khi DB chưa có account nào (mật khẩu 12-72 byte)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Link trong thư mời / đặt lại mật khẩu
IDENTITY_APP_URL=http://localhost:3000

# Mail (make run-worker): Mailpit trong compose nhận thư, xem ở http://localhost:8025.
# Không chạy compose thì đặt MAIL_TRANSPORT=log: thư (kèm link) in ra log.
MAIL_TRANSPORT=smtp
MAIL_FROM=StoreIt <no-reply@storeit.dev>
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_TLS=none

# Swagger UI ở http://localhost:8080/api/docs (chỉ dev)
HTTP_API_DOCS=true

# Gửi thật qua Resend SMTP khi chạy worker trên host: thay khối Mailpit ở trên bằng
#MAIL_FROM=StoreIt <no-reply@your-domain.com>
#MAIL_SMTP_HOST=smtp.resend.com
#MAIL_SMTP_PORT=465
#MAIL_SMTP_TLS=tls
#MAIL_SMTP_USERNAME=resend
#MAIL_SMTP_PASSWORD_FILE=../deploy/app/secrets/smtp_password.txt
