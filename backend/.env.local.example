# Env cho Go chạy trên host (make run-api, make test), Docker không dùng file này.
# cp .env.local.example .env.local
# Được Makefile include (cú pháp make): KEY=value, không dùng dấu nháy.

# Địa chỉ HTTP server nghe (server.Config)
HTTP_ADDR=:8080

PGHOST=127.0.0.1
# Phải khớp PG_PORT trong .env
PGPORT=5432
PGDATABASE=storeit
PGUSER=app_user
PGPASSWORD_FILE=./deploy/postgres/secrets/pg_app_pw.txt
PGSSLMODE=verify-full
PGSSLROOTCERT=./deploy/postgres/certs/rootCA.pem

# json (mặc định) | pretty; debug | info | warn | error
LOG_FORMAT=pretty
LOG_LEVEL=info

# JWT: keyring "kid:base64,..." trong file, JWT_ACTIVE_KID phải có trong keyring
JWT_KEYS_FILE=./deploy/app/secrets/jwt_keys.txt
JWT_ACTIVE_KID=v1
JWT_ISSUER=storeit

# Identity: dev chạy http nên tắt cờ Secure của cookie refresh
IDENTITY_COOKIE_SECURE=false
# Administrator đầu tiên, tạo khi DB chưa có account nào (mật khẩu 12-72 byte)
ADMIN_EMAIL=
ADMIN_PASSWORD=
