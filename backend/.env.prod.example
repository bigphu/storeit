# Env cho compose.prod.yml (chỉ để thay ${...}, KHÔNG tự vào container).
# Trên server: cp .env.prod.example .env
# Không để mật khẩu ở đây: dùng deploy/**/secrets/*.txt (sh deploy/scripts/init.sh)

# Image đã build + push: docker build --target prod -t <image> . && docker push <image>
# Dùng tag version/git SHA, không dùng latest
STOREIT_IMAGE=registry.example.com/storeit:1.0.0

# Port của app trên 127.0.0.1 (reverse proxy trỏ vào đây)
APP_PORT=8080

# DB + user của app — do deploy/postgres/initdb/01-app.sh tạo lần đầu
APP_DB_NAME=storeit
APP_DB_USER=app_user

# JWT (không phải secret; keyring nằm ở deploy/app/secrets/jwt_keys.txt)
JWT_ACTIVE_KID=v1
JWT_ISSUER=storeit

# Administrator đầu tiên, tạo khi DB chưa có account nào (mật khẩu 12-72 byte).
# Đăng nhập được rồi thì xoá hai dòng này.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend: link trong thư mời / đặt lại mật khẩu trỏ về đây
APP_URL=https://storeit.example.com

# Thư gửi qua SMTP của Resend (smtp.resend.com:465, username "resend"). Domain của
# MAIL_FROM phải được xác thực ở Resend (SPF, DKIM). API key dán vào
# deploy/app/secrets/smtp_password.txt (init.sh tạo file rỗng, không commit)
MAIL_FROM=StoreIt <no-reply@storeit.example.com>
MAIL_REPLY_TO=

# Mạng compose và proxy được tin để đọc IP client từ X-Forwarded-For (rate limit,
# IP của phiên). Mặc định tin cả dải mạng compose: reverse proxy trên host đi vào
# qua gateway của nó. nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# Caddy đặt sẵn.
APP_NET_SUBNET=172.30.0.0/24
#HTTP_TRUSTED_PROXIES=172.30.0.0/24
